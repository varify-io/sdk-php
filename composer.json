{
    "name": "varify-io/varify-sdk-php",
    "description": "Monorepo of the Varify server-side SDKs for PHP",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "2.59.0",
        "ergebnis/phpstan-rules": "2.19.0",
        "php-cs-fixer/shim": "3.95.32",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "11.5.58",
        "rector/rector": "2.9.2",
        "shopware/core": ">=6.7.10.0 <6.8.0.0",
        "shopware/storefront": ">=6.7.10.0 <6.8.0.0",
        "slevomat/coding-standard": "8.32.0",
        "squizlabs/php_codesniffer": "4.0.4"
    },
    "replace": {
        "varify-io/core": "self.version",
        "varify-io/shopware": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Varify\\Core\\": "packages/core/src/",
            "Varify\\Shopware\\": "packages/shopware/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Varify\\Core\\Tests\\": "packages/core/tests/",
            "Varify\\Shopware\\Tests\\": "packages/shopware/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": false,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "composer validate --strict",
            "composer normalize --dry-run",
            "composer normalize --dry-run packages/core/composer.json",
            "composer normalize --dry-run packages/shopware/composer.json",
            "@rector",
            "@phpcsfixer",
            "@phpcs",
            "@phpstan"
        ],
        "lint:fix": [
            "composer normalize",
            "composer normalize packages/core/composer.json",
            "composer normalize packages/shopware/composer.json",
            "@rector:fix",
            "@phpcsfixer:fix",
            "@phpcs:fix"
        ],
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpcsfixer": "php-cs-fixer fix --dry-run --diff",
        "phpcsfixer:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "phpunit"
    }
}
